<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\AccessDoor.ico</ApplicationIcon>
    <AssemblyName>EPSBAccessDoor</AssemblyName>
    <RootNamespace>AccessDoor.Desktop</RootNamespace>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\login.png" LogicalName="login.png" />
    <EmbeddedResource Include="Resources\loading.gif" LogicalName="loading.gif" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessDoor.Core\AccessDoor.Core.csproj" />
  </ItemGroup>

  <!-- The WebView2 package references its WPF control for every .NET 5+ app. This app is WinForms
       only, and that WPF assembly causes a WindowsBase version conflict (MSB3277), so drop it. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
