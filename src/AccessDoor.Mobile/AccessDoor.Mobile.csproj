<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Override with -p:MobileTargetFrameworks=... to build one platform without the other's workload. -->
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(MobileTargetFrameworks)' != ''">$(MobileTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AccessDoor.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <!-- Generate XAML as C# at build time instead of inflating it at runtime (faster page creation). -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>AccessDoor</ApplicationTitle>
    <!-- Keep the original package/bundle ids so existing installs upgrade in place. -->
    <ApplicationId>AccessDoor.AccessDoor</ApplicationId>
    <ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">com.companyname.AccessDoor</ApplicationId>
    <ApplicationDisplayVersion>2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#38C6A4" />
    <MauiSplashScreen Include="Resources\Images\login.png" Color="#38C6A4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessDoor.Core\AccessDoor.Core.csproj" />
  </ItemGroup>

</Project>
